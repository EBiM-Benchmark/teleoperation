+    def _handle_twist_stamped_state(
+        self,
+        topic_name: str,
+        message: Message,
+        ros_message: TwistStamped,
+        robot_states: dict[str, list[RobotState]],
+    ) -> None:
+        """Handle TwistStamped message extraction for configured observation topics.
+
+        TwistStamped was previously only reachable on the action path, so a velocity
+        observation (a mobile base's measured or applied twist) was logged as an
+        unsupported schema and dropped. Mirrors ``_handle_twist_stamped`` but emits a
+        ``RobotState``.
+        """
+        try:
+            linear = ros_message.twist.linear
+            angular = ros_message.twist.angular
+
+            robot_state = RobotState(
+                timestamp_ns=message.log_time,
+                publish_time_ns=message.publish_time,
+                values=[linear.x, linear.y, linear.z, angular.x, angular.y, angular.z],
+                names=[
+                    "linear_x",
+                    "linear_y",
+                    "linear_z",
+                    "angular_x",
+                    "angular_y",
+                    "angular_z",
+                ],
+            )
+
+            if topic_name not in robot_states:
+                robot_states[topic_name] = []
+
+            robot_states[topic_name].append(robot_state)
+
+        except Exception as e:
+            logger.error(f"Failed to extract TwistStamped state from {topic_name}: {e}")
+
