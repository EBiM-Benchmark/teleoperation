+++ b/services/pipeline/data-collection/src/services/teleop.py
@@ -132,6 +132,14 @@ class TeleopService:
                     logger.error("Failed to recover to IDLE after start_syncing failure")
             raise e
 
+        # SYNCING -> FOLLOWING is normally driven by a controller coordinator reporting
+        # FOLLOWING. When none are configured (the hardware is driven outside LABS)
+        # nothing ever reports, so the workflow would stick in SYNCING - and the UI's
+        # "Start recording" button only exists in the FOLLOWING button set.
+        if not self.robot_service.controller_coordinator_states:
+            logger.info("No controller coordinators configured; advancing SYNCING -> FOLLOWING")
+            self.state_machine.start_following()
+
         logger.info("Syncing started successfully")
         return TeleopResponse(status="success", message="Syncing started")
 
