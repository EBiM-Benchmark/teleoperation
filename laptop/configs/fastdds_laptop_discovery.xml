<?xml version="1.0" encoding="UTF-8" ?>
<!--
  Laptop-side FastDDS profile for talking to the TMR with NATIVE (default) discovery.

  Assumes multicast works on the laptop<->robot Ethernet link (direct cable / dumb switch,
  or a managed switch with multicast/IGMP enabled). Verify first:
    (robot)  ros2 multicast receive
    (laptop) ros2 multicast send      # robot should print the received message

  This laptop keeps WiFi up for internet, so it is multi-homed. This profile pins DDS to
  the Ethernet NIC (interfaceWhiteList) so it uses/advertises only the current 172.16.16.x
  laptop address. configs/tmr_laptop_env.sh renders this template with the active address,
  while the value below is only a placeholder for direct/manual use. It
  keeps DEFAULT (SIMPLE, multicast) discovery on that interface. No discovery server, no
  initial-peers, and NO config needed on the robot.

  If you use a direct cable and disable WiFi during teleop, you may not even need this file
  (plain RMW=rmw_fastrtps_cpp + ROS_DOMAIN_ID=0 is enough). Keep it while WiFi stays on.

  Source configs/tmr_laptop_env.sh so DHCP address changes are handled automatically.

  Usage (laptop):
    export RMW_IMPLEMENTATION=rmw_fastrtps_cpp
    export ROS_DOMAIN_ID=0
    export FASTRTPS_DEFAULT_PROFILES_FILE=$PWD/configs/fastdds_laptop_discovery.xml
    unset ROS_DISCOVERY_SERVER
-->
<dds>
  <profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
    <transport_descriptors>
      <transport_descriptor>
        <transport_id>eth_udp</transport_id>
        <type>UDPv4</type>
        <interfaceWhiteList>
          <address>172.16.16.232</address>
        </interfaceWhiteList>
      </transport_descriptor>
    </transport_descriptors>

    <participant profile_name="laptop_eth" is_default_profile="true">
      <rtps>
        <userTransports>
          <transport_id>eth_udp</transport_id>
        </userTransports>
        <useBuiltinTransports>false</useBuiltinTransports>
      </rtps>
    </participant>
  </profiles>
</dds>
